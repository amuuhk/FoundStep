# FoundStep environment variables
# Copy this file to .env and fill in your project's values.
# Never commit the real .env file.

# Supabase project URL (from your Supabase dashboard)
VITE_SUPABASE_URL=

# Supabase anon (public) key (from your Supabase dashboard)
VITE_SUPABASE_ANON_KEY=

